// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICER
  INVESTIGATOR
  AUDITOR
}

enum ActionType {
  CREATE
  READ
  UPDATE
  DELETE
  SHARE
  DOWNLOAD
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  EVIDENCE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  badgeNumber  String?    @unique
  role         Role       @default(OFFICER)
  department   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  documents    Document[] @relation("DocumentCreator")
  auditLogs    AuditLog[]
}

model Case {
  id          String     @id @default(uuid())
  caseNumber  String     @unique
  title       String
  description String?
  status      String     @default("OPEN")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  documents   Document[]
}

model Document {
  id               String            @id @default(uuid())
  title            String
  description      String?
  classification   String            // e.g., "CONFIDENTIAL", "PUBLIC", "RESTRICTED"
  status           DocumentStatus    @default(ACTIVE)
  currentVersionId String?
  caseId           String?
  caseRecord       Case?             @relation(fields: [caseId], references: [id])
  creatorId        String
  creator          User              @relation("DocumentCreator", fields: [creatorId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  versions         DocumentVersion[]
  auditLogs        AuditLog[]
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  versionNum  Int
  s3Key       String   // Path to file in storage
  fileHash    String   // SHA-256 hash for integrity
  onchainTxId String?  // Blockchain transaction hash for irrefutable proof
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())
  createdBy   String   // User ID
}

model AuditLog {
  id         String     @id @default(uuid())
  action     ActionType
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  documentId String?
  document   Document?  @relation(fields: [documentId], references: [id])
  ipAddress  String?
  userAgent  String?
  details    Json?      // Additional contextual data
  timestamp  DateTime   @default(now())
}
